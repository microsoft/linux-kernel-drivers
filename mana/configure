#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Per-kernel feature probe framework. Emits compat/autogen/mana_compat_autoconf.h
# with sentinel MANA_COMPAT_AUTOCONF_GENERATED and one #define per probed
# feature. Later shim commits append probes here just before the shim that
# consumes each probe.

set -eu

KERNELDIR=/lib/modules/$(uname -r)/build
while [ $# -gt 0 ]; do
    case "$1" in
        --kerneldir) KERNELDIR="$2"; shift 2 ;;
        --kerneldir=*) KERNELDIR="${1#--kerneldir=}"; shift ;;
        *) echo "configure: unknown arg: $1" >&2; exit 1 ;;
    esac
done

[ -d "$KERNELDIR" ] || { echo "configure: not a directory: $KERNELDIR" >&2; exit 1; }

SRCROOT=$(dirname "$0")
OUT_DIR="$SRCROOT/compat/autogen"
mkdir -p "$OUT_DIR"
OUT="$OUT_DIR/mana_compat_autoconf.h"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# probe FLAG "headers" "body"
#   Compile-tests a tiny TU against $KERNELDIR. Emits `#define FLAG 1` on
#   success, `#define FLAG 0` on failure.
probe() {
    _flag="$1"; _headers="$2"; _body="$3"
    cat > "$TMP/probe.c" <<EOF
#include <linux/module.h>
$_headers
MODULE_LICENSE("GPL");
static int _probe_body(void){ $_body; return 0; }
EOF
    echo 'obj-m += probe.o' > "$TMP/Kbuild"
    if make -s -C "$KERNELDIR" M="$TMP" modules >/dev/null 2>&1; then
        echo "#define $_flag 1" >> "$OUT"
    else
        echo "#define $_flag 0" >> "$OUT"
    fi
    rm -f "$TMP"/probe.* "$TMP"/.probe.* "$TMP"/Module.symvers "$TMP"/modules.order "$TMP"/Kbuild 2>/dev/null || true
}

# Emit header preamble
{
    echo "/* Auto-generated by ./configure -- do not edit. */"
    echo "#ifndef MANA_COMPAT_AUTOCONF_H"
    echo "#define MANA_COMPAT_AUTOCONF_H"
    echo ""
    echo "#define MANA_COMPAT_AUTOCONF_GENERATED 1"
    echo ""
} > "$OUT"

# No probes yet at bootstrap. Future commits append probe() calls here.
probe MANA_HAVE_EXPORT_SYMBOL_NS_STRING \
"#include <linux/module.h>" \
"EXPORT_SYMBOL_NS(_probe_body, \"NET_MANA\");"

# page_pool: helpers.h split (v6.6), field additions (napi @6.6, netdev @6.12),
# PP_FLAG_PAGE_FRAG removal (@6.7), page_pool_free_va (@6.12).
probe MANA_HAVE_PAGE_POOL_HELPERS \
"#include <net/page_pool/helpers.h>" \
"page_pool_recycle_direct(NULL, NULL);"

probe MANA_HAVE_PAGE_POOL_PARAMS_NAPI \
"#include <net/page_pool/types.h>" \
"struct page_pool_params _p; _p.napi = (struct napi_struct *)0; (void)_p;"

probe MANA_HAVE_PAGE_POOL_PARAMS_NETDEV \
"#include <net/page_pool/types.h>" \
"struct page_pool_params _p; _p.netdev = (struct net_device *)0; (void)_p;"

probe MANA_HAVE_PAGE_POOL_FREE_VA \
"#include <net/page_pool/helpers.h>" \
"page_pool_free_va(NULL, (void *)0, false);"

probe MANA_HAVE_PP_FLAG_PAGE_FRAG \
"#include <net/page_pool/types.h>" \
"unsigned int _f = PP_FLAG_PAGE_FRAG; (void)_f;"

# netdev helpers used at anchor: netif_napi_add_weight (v5.19+), netif_napi_add_tx
# (v5.19+); both need bridges on 5.15.
probe MANA_HAVE_NETIF_NAPI_ADD_WEIGHT \
"#include <linux/netdevice.h>" \
"netif_napi_add_weight((struct net_device *)0, (struct napi_struct *)0, (int (*)(struct napi_struct *, int))0, 0);"

probe MANA_HAVE_NETIF_NAPI_ADD_TX \
"#include <linux/netdevice.h>" \
"netif_napi_add_tx((struct net_device *)0, (struct napi_struct *)0, (int (*)(struct napi_struct *, int))0);"

{
    echo ""
    echo "#endif /* MANA_COMPAT_AUTOCONF_H */"
} >> "$OUT"

echo "configure: wrote $OUT" >&2
