#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# MANA out-of-tree compat probe generator.
#
# Compile-tests the *target* kernel headers and emits
# compat/autogen/mana_compat_autoconf.h with a complete MANA_HAVE_* map. The
# umbrella requires that generated map; there is no version-based fallback.
#
# This is the kernel-backports / ZFS-autoconf model: each probe builds a tiny
# module object against $KDIR using the kernel's own build flags, so a feature
# is reported present iff it actually compiles on that kernel -- correct even on
# distro kernels that backport features ahead of their mainline release.
#
# Invoked by the checked top-level Makefile for every manual and DKMS build. It
# can also be run directly for diagnostics. POSIX sh only.

set -eu

self=$(basename "$0")
srcdir=$(cd "$(dirname "$0")" && pwd)

KDIR=
OUT="$srcdir/compat/autogen/mana_compat_autoconf.h"
OUT_TMP=
VERBOSE=0

usage() {
	cat <<EOF
Usage: $self [--kerneldir DIR] [--out FILE] [--verbose]

  --kerneldir DIR  Kernel build tree to probe
                   (default: /lib/modules/\$(uname -r)/build)
  --out FILE       Output autoconf header
                   (default: compat/autogen/mana_compat_autoconf.h)
  --verbose        Echo each probe result to stderr
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
	--kerneldir) KDIR=$2; shift 2 ;;
	--kerneldir=*) KDIR=${1#*=}; shift ;;
	--out) OUT=$2; shift 2 ;;
	--out=*) OUT=${1#*=}; shift ;;
	--verbose|-v) VERBOSE=1; shift ;;
	-h|--help) usage; exit 0 ;;
	*) echo "$self: unknown argument: $1" >&2; usage >&2; exit 2 ;;
	esac
done

if [ -z "$KDIR" ]; then
	KDIR="/lib/modules/$(uname -r)/build"
fi

# Invalidate any map produced for a previous kernel before attempting the new
# probe. A failed configure must never leave stale feature decisions grafted
# into a later direct kbuild invocation.
mkdir -p "$(dirname "$OUT")"
OUT_TMP="$OUT.tmp.$$"
rm -f "$OUT" "$OUT_TMP"

if [ ! -e "$KDIR/Makefile" ]; then
	echo "$self: '$KDIR' does not look like a kernel build tree (no Makefile)." >&2
	echo "$self: pass --kerneldir or install the matching kernel headers." >&2
	exit 1
fi

# Normalise to an absolute path for the out-of-tree build.
KDIR=$(cd "$KDIR" && pwd)

TMP=$(mktemp -d "${TMPDIR:-/tmp}/mana-conf.XXXXXX")
trap 'rm -rf "$TMP"; rm -f "$OUT_TMP"' EXIT HUP INT TERM

build=$TMP/build
mkdir -p "$build"
# Force missing prototypes/types to be hard errors so a feature that is absent
# fails the probe build instead of silently compiling.
cat > "$build/Kbuild" <<'EOF'
obj-m := probe.o
ccflags-y += -Werror=implicit-function-declaration -Werror=implicit-int
ccflags-y += -Werror=return-type
EOF

# compile_test HEADERS BODY  -> 0 if the snippet builds against $KDIR
compile_test() {
	_headers=$1
	_body=$2
	: > "$build/log"
	if ! make -C "$KDIR" M="$build" clean >>"$build/log" 2>&1; then
		return 1
	fi
	{
		printf '%s\n' "$_headers"
		printf 'static void mana_conftest(void)\n{\n'
		printf '%s\n' "$_body"
		printf '}\n'
		printf 'MODULE_LICENSE("GPL");\n'
	} > "$build/probe.c"

	make -C "$KDIR" M="$build" modules >>"$build/log" 2>&1
}

RESULTS=$TMP/results
: > "$RESULTS"

# probe FLAG HEADERS BODY
# Records "#define FLAG 1" if the snippet compiles, else "#define FLAG 0".
probe() {
	_flag=$1
	_headers=$2
	_body=$3
	if compile_test "$_headers" "$_body"; then
		_val=1
	else
		_val=0
	fi
	printf '#define %s %s\n' "$_flag" "$_val" >> "$RESULTS"
	if [ "$VERBOSE" = 1 ]; then
		printf '  %-38s %s\n' "$_flag" "$_val" >&2
	fi
}

# probe_old_new FLAG OLD_HEADERS OLD_BODY NEW_HEADERS NEW_BODY
# Records 0 when the old API form compiles, 1 when only the new form compiles,
# and fails configure if neither form is usable.
probe_old_new() {
	_flag=$1
	_old_headers=$2
	_old_body=$3
	_new_headers=$4
	_new_body=$5
	if compile_test "$_old_headers" "$_old_body"; then
		_val=0
	elif compile_test "$_new_headers" "$_new_body"; then
		_val=1
	else
		echo "$self: ERROR: neither supported form of $_flag compiled." >&2
		[ "$VERBOSE" = 1 ] && cat "$build/log" >&2
		exit 1
	fi
	printf '#define %s %s\n' "$_flag" "$_val" >> "$RESULTS"
	if [ "$VERBOSE" = 1 ]; then
		printf '  %-38s %s\n' "$_flag" "$_val" >&2
	fi
}

# require DESC HEADERS BODY
# Hard architecture and Kconfig prerequisites from the in-tree driver's Kconfig.
# They are not version-shimmable; fail now with a clear message instead of deep
# in the module build or, worse, at modprobe time.
require() {
	_desc=$1
	_headers=$2
	_body=$3
	if ! compile_test "$_headers" "$_body"; then
		echo "$self: ERROR: required kernel feature missing: $_desc" >&2
		echo "$self: the target kernel ($KDIR) must be built with it enabled." >&2
		[ "$VERBOSE" = 1 ] && cat "$build/log" >&2
		exit 1
	fi
	[ "$VERBOSE" = 1 ] && printf '  %-38s %s\n' "require:$_desc" ok >&2
	return 0
}

[ "$VERBOSE" = 1 ] && echo "$self: checking hard prerequisites" >&2 || :

require "x86_64 or little-endian arm64" \
"#include <linux/module.h>
#if !defined(CONFIG_X86_64)
#if !defined(CONFIG_ARM64) || defined(CONFIG_CPU_BIG_ENDIAN)
#error unsupported-mana-architecture
#endif
#endif" \
"(void)0;"

require "CONFIG_PCI_MSI" \
"#include <linux/module.h>
#include <linux/kconfig.h>
#if !IS_ENABLED(CONFIG_PCI_MSI)
#error config-pci-msi-disabled
#endif" \
"(void)0;"

require "CONFIG_PCI_HYPERV" \
"#include <linux/module.h>
#include <linux/kconfig.h>
#if !IS_ENABLED(CONFIG_PCI_HYPERV)
#error config-pci-hyperv-disabled
#endif" \
"(void)0;"

require "CONFIG_PAGE_POOL (page_pool_create)" \
"#include <linux/module.h>
#if defined(__has_include)
# if __has_include(<net/page_pool/types.h>)
#  include <net/page_pool/types.h>
#  include <net/page_pool/helpers.h>
# else
#  include <net/page_pool.h>
# endif
#else
# include <net/page_pool.h>
#endif" \
"(void)page_pool_create((void *)0);"

require "CONFIG_AUXILIARY_BUS (auxiliary_device_init)" \
"#include <linux/module.h>
#include <linux/auxiliary_bus.h>" \
"(void)auxiliary_device_init((void *)0);"

[ "$VERBOSE" = 1 ] && echo "$self: probing $KDIR" >&2 || :

# ---- symbol export ---------------------------------------------------------
# Probe the mutually preferred forms in order: a bare token compiles with the
# old API, while the new API requires a string literal. Trying both detects a
# backport without relying on LINUX_VERSION_CODE and also verifies that at least
# one usable form exists.
probe_old_new MANA_HAVE_EXPORT_SYMBOL_NS_STRING \
"#include <linux/module.h>
#include <linux/export.h>
void mana_export_ns_token_probe(void) {}
EXPORT_SYMBOL_NS(mana_export_ns_token_probe, MANA_COMPAT_PROBE);" \
"(void)0;" \
"#include <linux/module.h>
#include <linux/export.h>
void mana_export_ns_quoted_probe(void) {}
EXPORT_SYMBOL_NS(mana_export_ns_quoted_probe, \"MANA_COMPAT_PROBE\");" \
"(void)0;"

# ---- page pool -------------------------------------------------------------
PP_INCLUDE='#include <linux/module.h>
#if defined(__has_include)
# if __has_include(<net/page_pool/types.h>)
#  include <net/page_pool/types.h>
#  include <net/page_pool/helpers.h>
# else
#  include <net/page_pool.h>
# endif
#else
# include <net/page_pool.h>
#endif'

probe MANA_HAVE_PAGE_POOL_HELPERS \
"#include <linux/module.h>
#include <net/page_pool/helpers.h>" \
"(void)0;"

probe MANA_HAVE_PAGE_POOL_PARAMS_NAPI \
"$PP_INCLUDE" \
"struct page_pool_params _p; _p.napi = (void *)0; (void)_p;"

probe MANA_HAVE_PAGE_POOL_PARAMS_NETDEV \
"$PP_INCLUDE" \
"struct page_pool_params _p; _p.netdev = (void *)0; _p.queue_idx = 0; (void)_p;"

probe MANA_HAVE_PAGE_POOL_FREE_VA \
"$PP_INCLUDE" \
"page_pool_free_va((void *)0, (void *)0, false);"

probe MANA_HAVE_PAGE_POOL_DMA_SYNC_FOR_CPU \
"$PP_INCLUDE" \
"page_pool_dma_sync_for_cpu((void *)0, (void *)0, 0, 0);"

# PP_FLAG_PAGE_FRAG was removed in v6.7 (commit 09d96ee5674a); fragment
# accounting became always-on. On kernels that still define it, a pool used
# with page_pool_dev_alloc_frag() MUST set this flag or page_pool_alloc_frag()
# WARNs and returns NULL. Present iff the macro exists.
probe MANA_HAVE_PP_FLAG_PAGE_FRAG \
"$PP_INCLUDE" \
"(void)(PP_FLAG_PAGE_FRAG);"

# ---- net_shaper ------------------------------------------------------------
# Authoritative signal is the net_device_ops member that forces the marked hunk.
probe MANA_HAVE_NET_SHAPER \
"#include <linux/module.h>
#include <linux/netdevice.h>" \
"struct net_device_ops _o; _o.net_shaper_ops = (void *)0; (void)_o;"

# ---- netdev instance lock --------------------------------------------------
probe MANA_HAVE_NETDEV_LOCK \
"#include <linux/module.h>
#include <linux/netdevice.h>
#include <net/netdev_lock.h>" \
"netif_napi_add_locked((void *)0, (void *)0, (void *)0);"

# netdev_lock()/netdev_unlock() are the per-instance ops-mutex primitives.
# They landed with the netdev instance-lock work; upstream places them in
# <linux/netdevice.h> (v6.15+), separate from the sched of _locked helpers
# in <net/netdev_lock.h>. Probe them separately so a distro that partially
# backports one but not the other is detected correctly.
probe MANA_HAVE_NETDEV_LOCK_FN \
"#include <linux/module.h>
#include <linux/netdevice.h>" \
"netdev_lock((void *)0); netdev_unlock((void *)0);"

# ---- ethtool ---------------------------------------------------------------
probe MANA_HAVE_ETHTOOL_RXFH_PARAM \
"#include <linux/module.h>
#include <linux/ethtool.h>" \
"struct ethtool_rxfh_param _p; (void)_p;"

probe MANA_HAVE_ETHTOOL_RINGPARAM_EXT \
"#include <linux/module.h>
#include <linux/ethtool.h>" \
"struct kernel_ethtool_ringparam _p; (void)_p;"

probe MANA_HAVE_ETHTOOL_PUTS \
"#include <linux/module.h>
#include <linux/ethtool.h>" \
"ethtool_puts((void *)0, (void *)0);"

probe MANA_HAVE_ETHTOOL_OPS_RX_RING_COUNT \
"#include <linux/module.h>
#include <linux/ethtool.h>" \
"struct ethtool_ops _o; _o.get_rx_ring_count = (void *)0; (void)_o;"

probe MANA_HAVE_ETHTOOL_COALESCE_RX_CQE_FRAMES \
"#include <linux/module.h>
#include <linux/ethtool.h>" \
"struct kernel_ethtool_coalesce _c; _c.rx_cqe_frames = 0; _c.rx_cqe_nsecs = 0; (void)_c;"

probe MANA_HAVE_ETHTOOL_OPS_NEEDS_RTNL \
"#include <linux/module.h>
#include <linux/ethtool.h>" \
"struct ethtool_ops _o; _o.op_needs_rtnl = 0; (void)_o;"

# ---- cpumask ---------------------------------------------------------------
probe MANA_HAVE_CPUMASK_WEIGHT_ANDNOT \
"#include <linux/module.h>
#include <linux/cpumask.h>" \
"(void)cpumask_weight_andnot((void *)0, (void *)0);"

probe MANA_HAVE_CPUMASK_VAR_CLEANUP \
"#include <linux/module.h>
#include <linux/cpumask.h>
#include <linux/cleanup.h>" \
"struct cpumask *_m __free(free_cpumask_var) = (void *)0; (void)_m;"

# ---- misc kernel / net helpers ---------------------------------------------
probe MANA_HAVE_NETIF_NAPI_ADD_WEIGHT \
"#include <linux/module.h>
#include <linux/netdevice.h>" \
"netif_napi_add_weight((void *)0, (void *)0, (void *)0, 0);"

probe MANA_HAVE_PCI_MSIX_DYN \
"#include <linux/module.h>
#include <linux/pci.h>" \
"(void)pci_msix_can_alloc_dyn((void *)0);"

probe MANA_HAVE_NETIF_SET_TSO_MAX_SIZE \
"#include <linux/module.h>
#include <linux/netdevice.h>" \
"netif_set_tso_max_size((void *)0, 0);"

probe MANA_HAVE_NETDEV_HOLD \
"#include <linux/module.h>
#include <linux/netdevice.h>" \
"netdev_hold((void *)0, (void *)0, GFP_ATOMIC);"

probe MANA_HAVE_DISABLE_WORK_SYNC \
"#include <linux/module.h>
#include <linux/workqueue.h>" \
"(void)disable_work_sync((void *)0);"

probe MANA_HAVE_SKB_TCP_ALL_HEADERS \
"#include <linux/module.h>
#include <linux/skbuff.h>
#include <linux/tcp.h>" \
"(void)skb_tcp_all_headers((void *)0);"

# ---- xdp -------------------------------------------------------------------
# xdp_set_features_flag() (v6.3) is declared in <net/xdp.h>, NOT <linux/netdevice.h>;
# that header must be probed explicitly or the feature reads as absent on every
# kernel that actually has it (6.3+), and the shim's redefinition then collides
# with the real prototype mana.h pulls in via <net/xdp.h>. NETDEV_XDP_ACT_BASIC
# comes from <uapi/linux/netdev.h> via <linux/netdevice.h>.
probe MANA_HAVE_XDP_FEATURES \
"#include <linux/module.h>
#include <linux/netdevice.h>
#include <net/xdp.h>" \
"xdp_set_features_flag((void *)0, NETDEV_XDP_ACT_BASIC);"

probe MANA_HAVE_BPF_WARN_XDP_3ARG \
"#include <linux/module.h>
#include <linux/filter.h>" \
"bpf_warn_invalid_xdp_action((void *)0, (void *)0, 0);"

# ---- dynamic interrupt moderation (lib/dim) --------------------------------
# The in-tree driver gained `select DIMLIB` together with its interrupt
# moderation support. An out-of-tree module cannot select a Kconfig symbol, so
# detect whether the target kernel actually built lib/dim: with CONFIG_DIMLIB=n
# net_dim() & co. are not in vmlinux and the module would fail modpost with
# "Unknown symbol". compat/mana_compat_dim.h stubs them out in that case, and
# the register_netdev interceptor withdraws the adaptive-coalescing
# advertisement, leaving static interrupt moderation (plain doorbell writes,
# no library) fully functional.
probe MANA_HAVE_DIMLIB \
"#include <linux/module.h>
#include <linux/kconfig.h>
#if !IS_ENABLED(CONFIG_DIMLIB)
#error config-dimlib-disabled
#endif" \
"(void)0;"

# net_dim() took its end sample BY VALUE until v6.13 (commit 61bf0009a765
# "dim: pass dim_sample to net_dim() by reference"), which switched the
# parameter to a const pointer. The verbatim body uses the new pointer form.
# Passing the wrong one is a hard "incompatible type for argument" error, so
# exactly one of the two snippets compiles on any given kernel.
probe_old_new MANA_HAVE_NET_DIM_SAMPLE_PTR \
"#include <linux/module.h>
#include <linux/dim.h>" \
"struct dim_sample _s = {}; net_dim((struct dim *)0, _s);" \
"#include <linux/module.h>
#include <linux/dim.h>" \
"struct dim_sample _s = {}; net_dim((struct dim *)0, &_s);"

# ---- emit ------------------------------------------------------------------
{
	echo '/* SPDX-License-Identifier: GPL-2.0-or-later */'
	echo '/*'
	echo ' * AUTOGENERATED by ./configure -- do not edit.'
	echo ' *'
	echo " * Kernel build tree: $KDIR"
	echo " * Generated:         $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
	echo ' *'
	echo ' * Each MANA_HAVE_* below reflects a compile-test against the kernel'
	echo ' * headers above. The checked Makefile regenerates this map before'
	echo ' * every manual and DKMS build.'
	echo ' */'
	echo '#ifndef MANA_COMPAT_AUTOCONF_H'
	echo '#define MANA_COMPAT_AUTOCONF_H'
	echo
	echo '#define MANA_COMPAT_AUTOCONF_GENERATED 1'
	echo
	sort "$RESULTS"
	echo
	echo '#endif /* MANA_COMPAT_AUTOCONF_H */'
} > "$OUT_TMP"
mv -f "$OUT_TMP" "$OUT"

echo "$self: wrote $OUT"
